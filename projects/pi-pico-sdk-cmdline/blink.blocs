# blink.blocs - blink the onboard LED (GP25) at 1Hz
# Uses a not block as a toggle, feedback loop creates oscillation

search $EMBLOCS/src/components

blockdef pico_gpio  pico_gpio  INPUTS=0  OUTPUTS=0x02008000  ENABLES=0
blockdef not_block  not

block gpio      pico_gpio
block tog_led   not_block
block tog_pin   not_block

signal pin  bool  +tog_pin.out  +tog_pin.in  +gpio.pin15_out
signal led  bool  +tog_led.out  +tog_led.in  +gpio.pin25_out

thread init   1          +gpio.init
thread toggle 500000     +tog_pin.update  +gpio.write
thread blink  500000000  +tog_led.update
